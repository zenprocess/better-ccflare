# syntax=docker/dockerfile:1.7
#
# build-from-source Dockerfile for ccflare (zen-infra/ccflare pipeline).
#
# This file is intentionally separate from the upstream `Dockerfile` (which
# wraps a tombii release binary) and is meant to be merged onto the
# deploy/2026-07-30 branch. It builds the runtime from the repo source tree,
# so images built from this Dockerfile always carry our patches and any
# cherry-picks we stage on the deploy branch.
#
# Shape is the same as the existing `registry.zp.digital/zen-infra/ccflare:amd64`
# image (whose final stage inherits labels from `oven/bun:1.2.23-alpine`):
#
#   - runtime Bun is the BASE image (matches `source=github.com/oven-sh/bun`
#     in the inherited labels).
#   - port 8080, data dir `/data`, non-root ccflare user (uid 1000), volume
#     at `/data`, `BETTER_CCFLARE_DB_PATH=/data/better-ccflare.db`,
#     `XDG_CONFIG_HOME=/data`, `NODE_ENV=production`.
#   - HEALTHCHECK against `GET /health`.
#   - the final stage is the pinned oven/bun image so labels are inherited
#     cleanly.
#
# Required NOT to do:
#   - no `:canary` (or any moving tag) in a `FROM`. The build does not know
#     which canary revision the source repo was paired with; use a digest.
#   - no secrets baked in. Tokenized git remotes are forbidden.
#     Build-time credentials (e.g. private registry mirrors) are delivered
#     via `--mount=type=secret,id=...` only — names + Infisical paths in
#     the surrounding CI, never values.
#

# ---------------------------------------------------------------------------
# Pinned base. The digest placeholder below is the canary oven/bun image
# whose embedded `bun --revision` reports Bun commit
# 789be97db9b746533cf692e8367146e2d3c0d7cb (the fetch-abort fix merged to
# Bun main 2026-07-28). When ccflare-75 (or its successor) finalizes the
# digest, substitute it here and in the `FROM ${BUN_IMAGE} AS final` stage
# below — both stages MUST pin the SAME digest.
#
#   Per-arch amd64 manifest digest: REPLACE_BUN_CANARY_AMD64_DIGEST
#   Per-arch arm64 manifest digest: REPLACE_BUN_CANARY_ARM64_DIGEST
#   (used for linux/amd64 today; both kept ready for future multi-arch)
#
# While this placeholder is still set, `bun --revision` inside the image
# will NOT report 789be97. Resolve the digest before merging onto
# deploy/2026-07-30.
# ---------------------------------------------------------------------------
ARG BUN_IMAGE=oven/bun@sha256:REPLACE_BUN_CANARY_AMD64_DIGEST

# ===========================================================================
# Stage 1 — builder
# ===========================================================================
FROM ${BUN_IMAGE} AS builder

WORKDIR /build

# Reproducible dep install. Bun's hoisted workspace layout reads
# bun.lock at the monorepo root, so the manifest + lockfile pair has to
# land in the same COPY as the workspace package.jsons to maximize layer
# cacheability.
COPY bun.lock package.json biome.json ./
COPY apps ./apps
COPY packages ./packages

# `bun install --frozen-lockfile` rejects drift between package.json and
# bun.lock. We install the full tree (incl. devDependencies) so the
# downstream `bun run build:dashboard` can resolve its plugins.
RUN bun install --frozen-lockfile

# ---------------------------------------------------------------------------
# Generate the placeholder inline-worker source files consumed by
# `@better-ccflare/database/src/database-operations.ts`.
#
# The deploy branch's repo does NOT check these in (.gitignore
# excludes them). The compiled CLI binary normally encodes the worker
# bundles into these files at build time via `apps/cli/package.json`'s
# `build` script. For a runtime-only image that runs the server via `bun`
# (and never compiles the CLI), the empty placeholder values are correct:
# the runtime guards on `if (EMBEDDED_VACUUM_WORKER_CODE)`.
# ---------------------------------------------------------------------------
RUN mkdir -p packages/database/src && \
    printf '%s\n' \
      '// Auto-generated stub for from-source runtime. See Dockerfile.deploy.' \
      'export const EMBEDDED_VACUUM_WORKER_CODE = "";' \
      > packages/database/src/inline-vacuum-worker.ts && \
    printf '%s\n' \
      '// Auto-generated stub for from-source runtime. See Dockerfile.deploy.' \
      'export const EMBEDDED_INCREMENTAL_VACUUM_WORKER_CODE = "";' \
      > packages/database/src/inline-incremental-vacuum-worker.ts && \
    printf '%s\n' \
      '// Auto-generated stub for from-source runtime. See Dockerfile.deploy.' \
      'export const EMBEDDED_INTEGRITY_CHECK_WORKER_CODE = "";' \
      > packages/database/src/inline-integrity-check-worker.ts

# Build the React dashboard bundle. The server (apps/server) loads the
# manifest at `packages/dashboard-web/dist/manifest.json` and resolves
# chunk assets relative to it; baking the bundle into the image matches
# what the upstream binary embedded at compile time.
RUN bun run build:dashboard

# ===========================================================================
# Stage 2 — runtime (final)
# ===========================================================================
FROM ${BUN_IMAGE} AS final

# Reproduce the `BUN_IMAGE` ARG inside the final stage so the digest is
# recorded in both build stages (and so future code-generation can echo
# it into image labels).
ARG BUN_IMAGE
ENV BUN_IMAGE=${BUN_IMAGE}

# Runtime-only OS dependencies:
#   ca-certificates — TLS for outbound provider calls
#   curl            — used by the HEALTHCHECK probe
#   sqlite3         — CLI for operators who want to inspect /data/*.db
#                     (matches the surface the upstream Dockerfile carries;
#                     the runtime itself uses bun:sqlite so this is not load-
#                     bearing for the server)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Same env contract as the upstream Dockerfile + docker-compose.yml.
#   BETTER_CCFLARE_HOST lets the server bind to 0.0.0.0 (and only 0.0.0.0 —
#   the code at apps/server/src/server.ts defaults to that hostname
#   anyway, but we set it explicitly so the contract is reviewable in
#   one place).
ENV NODE_ENV=production \
    PORT=8080 \
    BETTER_CCFLARE_HOST=0.0.0.0 \
    BETTER_CCFLARE_DB_PATH=/data/better-ccflare.db \
    XDG_CONFIG_HOME=/data

WORKDIR /app

# Mirror the existing image's runtime user (ccflare, uid/gid 1000) and
# the `/data` volume. Created with --system so the user has no home
# shell session surprises on `docker exec`.
RUN groupadd --system --gid 1000 ccflare \
    && useradd  --system --uid 1000 \
                --gid ccflare \
                --shell /usr/sbin/nologin \
                --create-home --home-dir /home/ccflare \
                ccflare \
    && mkdir -p /data \
    && chown -R ccflare:ccflare /data /app

# Copy the production tree. Order matches the existing `.dockerignore`
# exclusion set, so the build context is the repo minus node_modules,
# dist/, build/, .git, docs/, *.db, etc.
COPY --from=builder --chown=ccflare:ccflare /build/bun.lock    ./bun.lock
COPY --from=builder --chown=ccflare:ccflare /build/package.json ./package.json
COPY --from=builder --chown=ccflare:ccflare /build/biome.json   ./biome.json
COPY --from=builder --chown=ccflare:ccflare /build/apps         ./apps
COPY --from=builder --chown=ccflare:ccflare /build/packages     ./packages
# node_modules is hoisted to the workspace root by `bun install`. We
# bring the full tree over (including devDependencies) to keep the
# server's dynamic imports resolvable; `bun --hot` and the
# usage/usage-worker import graph reach into `bun:test`, biome, etc.
# when run interactively. Tighten if a smaller image is required.
COPY --from=builder --chown=ccflare:ccflare /build/node_modules ./node_modules

USER ccflare

# /data is the only writable mount the server expects. Compose's
# `better-ccflare-data:/data` and the DOCKER.md `docker run -v ...:/data`
# examples both point here.
VOLUME ["/data"]

# Same port the runtime expects + that compose forwards.
EXPOSE 8080

# Match the upstream image's healthcheck cadence. `start_period=40s`
# gives the server its ~15s startup budget twice over; an under-budgeted
# start_period produces noisy `unhealthy` flapping during cold starts.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT}/health || exit 1

# Default to the server entrypoint. `bun run apps/server/src/server.ts`
# honors `PORT` from the environment (apps/server/src/server.ts:1991)
# and falls back to NETWORK.DEFAULT_PORT (8080). The CLI is reachable
# inside the container as `docker exec <ctr> bun run apps/cli/src/main.ts ...`
# if you need account management without the Web UI.
CMD ["bun", "run", "apps/server/src/server.ts"]
